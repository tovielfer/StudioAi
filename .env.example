# Database
DATABASE_URL=postgresql://aistudio:aistudio@localhost:5432/aistudio

# Redis
REDIS_URL=redis://localhost:6379

# Local dev without Redis — set to "sync"
QUEUE_MODE=sync

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Storage (local fallback when R2 not configured)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
PUBLIC_API_URL=http://localhost:3001

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# AI Providers (optional — mock mode when empty)
REPLICATE_API_TOKEN=
FAL_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=

# Admin
ADMIN_SECRET=admin-secret-change-me

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
