# ─── Server ───────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://aistudio:aistudio@localhost:5432/aistudio

# Set to "true" ONLY in local dev when you need auto schema sync.
# In production this MUST be "false" — migrations handle schema changes.
DB_SYNCHRONIZE=false

# ─── Redis / Queue ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Set to "sync" to skip Redis entirely (local dev without Docker).
QUEUE_MODE=sync

# ─── Auth ─────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# ─── Storage ──────────────────────────────────────────────
# "local" or "r2"
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
PUBLIC_API_URL=http://localhost:3001

# ─── Cloudflare R2 (required when STORAGE_TYPE=r2) ────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── AI Providers (leave empty to use mock) ───────────────
REPLICATE_API_TOKEN=
FAL_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=

# ─── Admin ────────────────────────────────────────────────
# Protects POST /credits/add — use a strong secret in production
ADMIN_SECRET=admin-secret-change-me

# ─── Billing / Pricing (all optional — defaults shown) ────
# A credit is decoupled from USD and sold in ILS. Generation price in credits =
# ceil(providerCostUsd * TARGET_MARGIN * USD_ILS / CREDIT_VALUE_ILS).
# USD -> ILS exchange rate used to convert provider cost to shekels.
USD_ILS=3.7
# Sell margin over provider cost (sell = cost * margin). 2 = double your money.
TARGET_MARGIN=2.0
# Shekel value of one credit at the best (largest-package) rate. 0.01 => ₪1 = 100 credits.
CREDIT_VALUE_ILS=0.01

# ─── Billing / Pricing ────────────────────────────────────
# All optional — defaults below reproduce the current pricing.
# credits = ceil(providerCostUsd * TARGET_MARGIN * USD_ILS / CREDIT_VALUE_ILS)
#
# USD -> ILS exchange rate (used to convert provider cost to shekels).
USD_ILS=3.7
# Sell margin over provider cost (sell price = cost * margin). 2 = double.
TARGET_MARGIN=2.0
# Shekel value of one credit at the best (largest-package) rate.
# 0.01 means ₪1 = 100 credits. Lower it (e.g. 0.001) for bigger credit numbers.
CREDIT_VALUE_ILS=0.01

# ─── SUMIT (OfficeGuy) payment gateway ────────────────────
# Get these from https://app.sumit.co.il/developers/keys/
# SUMIT_API_KEY is SECRET — server only, never expose to the browser.
SUMIT_API_BASE=https://api.sumit.co.il
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
# Set to "false" to charge without auto-issuing a tax invoice/receipt.
SUMIT_ISSUE_DOCUMENT=true
# Public values — safe for the browser (used by payments.js tokenization).
NEXT_PUBLIC_SUMIT_COMPANY_ID=
NEXT_PUBLIC_SUMIT_API_PUBLIC_KEY=

# ─── Mail / SMTP (used by "send image by email") ──────────
# Example below is configured for Resend SMTP.
# MAIL_FROM must use a domain verified in Resend, or sending will fail.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
MAIL_FROM=My App <hello@your-verified-domain.com>
# Where user replies go. Use a real inbox you actually read.
MAIL_REPLY_TO=support@your-verified-domain.com

# ─── Frontend (Next.js) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
